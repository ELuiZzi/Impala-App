{
  "expo": {
    "name": "Impala",
    "slug": "impala",
    "scheme": "impala",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.luizzi.impala",
      "adaptiveIcon": {
        "backgroundColor": "#A235FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 13
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      [
        "./plugins/withCmakeVersion",
        {
          "version": "3.31.6"
        }
      ],
      "./plugins/withoutFontWeightAdjustment",
      "./plugins/withCleartextTraffic",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/montserrat/500Medium/Montserrat_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/montserrat/700Bold/Montserrat_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#fa2d48",
          "defaultChannel": "suscripciones"
        }
      ]
    ],
    "extra": {
      "githubRepo": "ELuiZzi/Impala-App"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
