{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Impala",
  "version": "1.6.2",
  "identifier": "com.luizzi.impala",
  "build": {
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": {
      "script": "npx expo export -p web --output-dir dist",
      "cwd": "../../app"
    },
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Impala",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "LuiZzi",
    "copyright": "LuiZzi",
    "category": "Music",
    "shortDescription": "Reproductor de música",
    "longDescription": "Impala: tu música del equipo o de tu servidor propio (Navidrome).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNUEzQkY4MUU2RTlEQzcKUldUSG5XNGUrRHRhU3FVb2xOWDZJUDZBdnVpeXF2cHI3Zk16SlViR21WUlBTMXYzMDZBaGRrTXEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
